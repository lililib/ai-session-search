{
  "name": "ai-session-search",
  "productName": "AI Session Search",
  "version": "0.4.0",
  "private": true,
  "description": "Read-only local search for AI coding agent conversations.",
  "type": "module",
  "main": "dist/desktop/main.cjs",
  "bin": {
    "ai-session-search": "./dist/server/main.mjs"
  },
  "scripts": {
    "dev": "run-p dev:server dev:client",
    "dev:server": "tsx watch src/server/main.ts",
    "dev:client": "vite",
    "build": "run-s build:client build:server build:desktop",
    "build:client": "vite build",
    "build:server": "tsdown src/server/main.ts --format esm --out-dir dist/server",
    "build:desktop": "tsdown --config tsdown.desktop.config.ts",
    "desktop:start": "run-s build && electron .",
    "desktop:package": "run-s build && electron-forge package",
    "desktop:make": "run-s build && electron-forge make",
    "start": "node dist/server/main.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "peerDependencies": {
    "electron": "43.2.0"
  },
  "packageManager": "pnpm@11.0.9",
  "dependencies": {
    "@hono/node-server": "2.0.1",
    "@lingui/core": "6.0.1",
    "@lingui/message-utils": "6.0.1",
    "@lingui/react": "6.0.1",
    "commander": "14.0.3",
    "hono": "4.12.18",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@types/node": "25.6.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react-swc": "4.3.0",
    "electron": "43.2.0",
    "npm-run-all2": "8.0.4",
    "tsdown": "0.21.10",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "8.0.11",
    "vitest": "4.1.5"
  }
}
